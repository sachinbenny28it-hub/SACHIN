# ── Server ────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:4000

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=30d

# ── MySQL ─────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=sachin_app
DB_PASSWORD=change_me
DB_NAME=sachin

# ── Free local AI (Ollama) ─────────────────────────────────
# No API key or paid credits required. Models must be pulled once with Ollama.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b
OLLAMA_ASR_MODEL=frozenlab/qwen3-asr:0.6b
OLLAMA_CONTEXT_LENGTH=2048

# ── RevenueCat ────────────────────────────────────────────
# Web Billing project + API key from app.revenuecat.com
REVENUECAT_PUBLIC_API_KEY=rcb_...
REVENUECAT_WEBHOOK_SECRET=whsec_...
